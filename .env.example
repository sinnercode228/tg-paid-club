# tg-paid-club settings. Copy to .env and fill in; `paidclub check` validates the result.
#
# Every setting is a PAIDCLUB_* environment variable; real environment variables win over
# this file. An empty value means "not set". Commented lines show the default.
# Lists take a comma-separated string (1,3) or JSON ([1, 3]); PAIDCLUB_PLANS is JSON.

# --- runtime ----------------------------------------------------------------------------------
# dev | test | prod. prod refuses the fake provider and hides /docs. The Docker image sets prod.
# PAIDCLUB_ENV=dev
# 1 for a public demo: allows the fake provider (whose page lets anyone "pay" without money)
# next to real providers or for club chats on a public PAIDCLUB_PUBLIC_BASE_URL, which
# `paidclub run` and `paidclub web` otherwise refuse.
# PAIDCLUB_DEMO=0
# DEBUG | INFO | WARNING | ERROR | CRITICAL
# PAIDCLUB_LOG_LEVEL=INFO
# Dates in messages to members and on the dashboard; storage is always UTC.
# PAIDCLUB_DISPLAY_TIMEZONE=Europe/Moscow

# --- storage ----------------------------------------------------------------------------------
# SQLite for a single process; PostgreSQL for production, as in
# postgresql+asyncpg://paidclub:paidclub@localhost:5432/paidclub (docker-compose.yml sets it).
# postgresql:// and sqlite:// URLs are switched to their async drivers automatically.
# PAIDCLUB_DATABASE_URL=sqlite+aiosqlite:///./paidclub.db

# --- telegram ---------------------------------------------------------------------------------
# From @BotFather. Required by `paidclub run`.
PAIDCLUB_BOT_TOKEN=
# Your own Telegram user id: /stats, /export and alerts go here; never removed from the club.
PAIDCLUB_OWNER_ID=
# Other user ids the bot must never remove from club chats (moderators, co-authors).
PAIDCLUB_ADMIN_IDS=
# The private channel and/or supergroup ids a subscription opens (-100...). The bot must be an
# admin there with the right to invite users (and, in a supergroup, to ban users).
PAIDCLUB_CLUB_CHAT_IDS=
# polling: the bot asks Telegram for updates, no public URL needed.
# webhook: Telegram pushes updates to PAIDCLUB_PUBLIC_BASE_URL/telegram/webhook, which must be
# HTTPS on port 443, 80, 88 or 8443.
# PAIDCLUB_BOT_MODE=polling
# Required in webhook mode: 1-256 characters of A-Z, a-z, 0-9, _ and -. Telegram sends it back
# in a header with every update. python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PAIDCLUB_TELEGRAM_WEBHOOK_SECRET=

# --- web --------------------------------------------------------------------------------------
# Where the web app (webhooks, checkout page, /admin) listens. The Docker image uses 0.0.0.0.
# PAIDCLUB_WEB_HOST=127.0.0.1
# PAIDCLUB_WEB_PORT=8000
# The address members and providers reach the web app at: checkout links, return URLs, payment
# webhooks (/webhooks/<provider>) and the Telegram webhook.
# PAIDCLUB_PUBLIC_BASE_URL=http://localhost:8000
# Opens /admin with "Authorization: Bearer <token>"; in a browser, log in as
# PAIDCLUB_ADMIN_USERNAME with the token as the password. With neither this nor
# PAIDCLUB_ADMIN_PASSWORD set, /admin answers 404. Login attempts are not limited, so prod
# refuses a token or password shorter than 16 characters:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
PAIDCLUB_ADMIN_TOKEN=
# HTTP basic auth for /admin. Put HTTPS in front: basic auth sends the password every time.
# PAIDCLUB_ADMIN_USERNAME=admin
PAIDCLUB_ADMIN_PASSWORD=
# Where a provider sends the member after paying, e.g. https://t.me/<your_bot>.
# Defaults to PAIDCLUB_PUBLIC_BASE_URL/paid, a page that sends the member back to the bot.
PAIDCLUB_CHECKOUT_RETURN_URL=

# --- plans and billing ------------------------------------------------------------------------
# What the club sells. Prices are copied onto a subscription when it starts, so a price change
# affects new subscribers only. price_stars is allowed on 1-month (or 30-day) plans only:
# Telegram Stars subscriptions renew every 30 days. The default is these three plans:
# PAIDCLUB_PLANS='[{"code": "month", "title": "1 месяц", "period_count": 1, "price_rub": "990.00", "price_stars": 500}, {"code": "quarter", "title": "3 месяца", "period_count": 3, "price_rub": "2490.00"}, {"code": "year", "title": "12 месяцев", "period_count": 12, "price_rub": "8900.00"}]'
# Payment providers to offer: yookassa, stars, or fake (the demo page: no money moves, anyone
# can "pay"). fake is for trying the bot locally; a real club sets yookassa, stars or
# yookassa,stars here.
PAIDCLUB_PROVIDERS=fake
# Access is kept this many days after a failed renewal charge while retries run.
# PAIDCLUB_GRACE_DAYS=3
# Retry a failed renewal this many days after the first failure (within the grace period).
# PAIDCLUB_DUNNING_RETRY_DAYS=1,3
# Remind members this many days before a renewal or the end of access.
# PAIDCLUB_REMINDER_DAYS=3,1
# Telegram renews Stars subscriptions itself and sends nothing when a renewal fails: after the
# period ends, wait this many minutes for the payment before treating it as failed.
# PAIDCLUB_STARS_RENEWAL_WAIT_MINUTES=60
# Required with stars in PAIDCLUB_PROVIDERS, at least 16 characters: signs Stars invoices.
# Telegram renews a subscription with the payload of its first invoice, so keep it unchanged
# while any Stars subscription is active, also after taking stars out of PAIDCLUB_PROVIDERS.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PAIDCLUB_STARS_PAYLOAD_SECRET=

# --- fake provider (demo) ---------------------------------------------------------------------
# Signs demo checkout links and webhooks. Unset, a random one is made at every start and older
# checkout links stop working.
PAIDCLUB_FAKE_WEBHOOK_SECRET=

# --- yookassa ---------------------------------------------------------------------------------
# Shop id and secret key from the YooKassa dashboard. Set its notification URL to
# PAIDCLUB_PUBLIC_BASE_URL/webhooks/yookassa/<PAIDCLUB_YOOKASSA_WEBHOOK_TOKEN> (HTTPS, port 443
# or 8443) with the payment.succeeded, payment.canceled and refund.succeeded events.
PAIDCLUB_YOOKASSA_SHOP_ID=
PAIDCLUB_YOOKASSA_SECRET_KEY=
# 16-128 characters (A-Z, a-z, 0-9, _ and -). Set, notifications are accepted only at the URL
# with it, so a forged one posted elsewhere costs no request to the shop API. Unset, the URL is
# PAIDCLUB_PUBLIC_BASE_URL/webhooks/yookassa.
#   python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
PAIDCLUB_YOOKASSA_WEBHOOK_TOKEN=
# PAIDCLUB_YOOKASSA_API_URL=https://api.yookassa.ru/v3

# --- workers ----------------------------------------------------------------------------------
# How often the scheduler charges renewals, expires subscriptions, removes members and reminds.
# PAIDCLUB_SCHEDULER_INTERVAL_SECONDS=30
# How long a worker owns a claimed renewal or message before another worker may take it over.
# PAIDCLUB_CLAIM_LEASE_SECONDS=300
# After a provider error (timeout, 5xx), retry the same charge after this long.
# PAIDCLUB_PROVIDER_RETRY_SECONDS=300
# A renewal the provider reports as pending is checked again after this long.
# PAIDCLUB_PENDING_RECHECK_SECONDS=900
# Messages sent per outbox round, and attempts before a message is marked failed.
# PAIDCLUB_OUTBOX_BATCH_SIZE=20
# PAIDCLUB_OUTBOX_MAX_ATTEMPTS=8

# --- docker compose only ----------------------------------------------------------------------
# Password of the PostgreSQL user in docker-compose.yml. The app's database URL is built from
# it, so keep to letters, digits, - and _.
# POSTGRES_PASSWORD=paidclub
